{
  "name": "@x1/infinity-mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Staging-only MCP v2 gateway for five X1 capability groups",
  "engines": {"node": ">=22"},
  "scripts": {
