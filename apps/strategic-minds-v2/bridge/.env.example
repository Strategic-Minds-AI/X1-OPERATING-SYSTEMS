# X1 Fleet Bridge Worker Environment
# Copy this file to .env and fill in your values.

# Your X1 app URL (find it in Settings)
X1_BASE_URL=

# Worker token (get this from the app's Secrets page — look for X1_WORKER_TOKEN)
X1_WORKER_TOKEN=

# Optional: name for this machine in the fleet (defaults to hostname)
X1_WORKER_NAME=
